# Environment Configuration
# Copy this file to .env and fill in your values

# Application Settings
DEBUG=True
APP_NAME=TravelOps AI Orchestrator
APP_VERSION=1.0.0

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Settings (JSON format for list)
# Use ["*"] to allow all origins (development)
# Use ["http://localhost:19006", "http://192.168.1.100:19006"] for specific origins
CORS_ORIGINS=["*"]

# Supabase Configuration (Optional - for integration with existing backend)
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here

# AI Model API Keys (Optional - for advanced AI features)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Redis Configuration (Optional - for caching)
REDIS_URL=redis://localhost:6379

# Budget Constraints
MIN_BUDGET_PER_PERSON=3000.0
MAX_TRAVELERS=10
