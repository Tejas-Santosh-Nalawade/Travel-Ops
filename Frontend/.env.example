# TravelOps Mobile App - Environment Configuration

# ============================================
# AI ORCHESTRATOR API SETTINGS
# ============================================

# Local Development (Replace with your computer's IP)
# Find your IP: Windows (ipconfig) / Mac/Linux (ifconfig)
EXPO_PUBLIC_API_URL=http://192.168.1.100:8000

# Credit card service (port 8001) - same computer IP
EXPO_PUBLIC_CREDIT_API_URL=http://192.168.1.100:8001

# Production (if deployed)
# EXPO_PUBLIC_API_URL=https://your-api-domain.com

# ============================================
# SUPABASE SETTINGS (if using)
# ============================================

EXPO_PUBLIC_SUPABASE_URL=your_supabase_url
EXPO_PUBLIC_SUPABASE_KEY=your_supabase_key

# ============================================
# HOW TO FIND YOUR LOCAL IP ADDRESS
# ============================================

# Windows:
# 1. Open Command Prompt
# 2. Run: ipconfig
# 3. Look for "IPv4 Address" under your active network adapter
# Example: 192.168.1.100

# Mac/Linux:
# 1. Open Terminal
# 2. Run: ifconfig | grep "inet "
# 3. Look for IP starting with 192.168
# Example: 192.168.1.100

# ============================================
# TESTING CONNECTION
# ============================================

# After configuring, test from browser on your phone:
# http://192.168.1.100:8000/health
#
# Should return:
# {"status":"healthy","orchestrator":"ready"...}

# ============================================
# TROUBLESHOOTING
# ============================================

# Cannot connect from phone:
# - Ensure phone and computer are on same WiFi
# - Check firewall settings on computer
# - Verify backend server is running
# - Use computer's IP, NOT localhost

# Connection timeout:
# - Backend server might not be running
# - Check: cd Backend/ai_orchestrator && python main.py
# - Verify port 8000 is not blocked

# ============================================
# NOTES
# ============================================

# - DO NOT commit this file with real credentials
# - Add .env to .gitignore
# - Use different .env files for dev/prod
# - Restart Expo after changing .env values
